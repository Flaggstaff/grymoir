#!/bin/sh
# Les scénarios de Praxis (7 novembre 2026, grammaire § 9.7) : projets/Praxis/Praxis/scenarios.grym, joués par
# « grym scenarios » sur une copie du projet, chacun sur une base neuve en mémoire. Ils gardent les parcours d'argent :
# régler, refuser, remettre à payer, facturer, relancer. Un échec arrête « ./appliquer ».
racine=$(cd "$(dirname "$0")/.." && pwd)
grym="$racine/grym"
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
cp -R "$racine/projets/Praxis/Praxis/." "$d/" || exit 1
cd "$d" || exit 1
if sortie="$("$grym" scenarios scenarios.grym 2>&1 < /dev/null)"; then
    echo "$sortie" | tail -1
    exit 0
fi
echo "$sortie" | grep -E "✗|scénarios?,|erreur"
echo
echo "Un scénario de Praxis ne passe plus (projets/Praxis/Praxis/scenarios.grym)."
echo "- Si Praxis a reçu un champ obligatoire, complète les actions d'aide « Installer » et « Poser » en tête du fichier."
echo "- Sinon, un parcours d'argent a changé : vérifie que c'est voulu avant de modifier le scénario."
exit 1
