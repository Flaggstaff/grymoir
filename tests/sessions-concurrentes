#!/bin/sh
# « grym servir --sessions » (grammaire 3.18, docs/v2.md, § 11, 8 novembre 2026) : deux navigateurs, deux sessions du même
# programme sur la même base ; chacun se connecte et répond pour lui. Les gardes de l'aiguilleur : sans le jeton de
# l'adresse, sans cookie, un autre hôte, une autre origine. Une session terminée renaît à la visite suivante.
# Sans python3, ou sous Windows (pas encore pris en charge), sauté.
racine=$(cd "$(dirname "$0")/.." && pwd)
grym="$racine/grym"
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) echo "sessions-concurrentes : sauté (Windows)"; exit 0;; esac
command -v python3 > /dev/null || { echo "sessions-concurrentes : sauté (python3 absent)"; exit 0; }
d=$(mktemp -d)
cp "$racine/tests/sessions/p.grym" "$d/"
cd "$d" || exit 1
"$grym" servir p.grym --sessions --sans-navigateur > ag.txt 2>&1 < /dev/null &
pid=$!
trap 'kill $pid 2> /dev/null; wait $pid 2> /dev/null; rm -rf "$d"' EXIT
n=0
while ! grep -q 'jeton=' ag.txt 2> /dev/null && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
port=$(grep -o '127.0.0.1:[0-9]*' ag.txt | head -1 | cut -d: -f2)
jeton=$(grep -o 'jeton=[0-9a-f]*' ag.txt | head -1 | cut -d= -f2)
echo "$port $jeton" > adr.txt
obtenu=$(python3 "$racine/tests/sessions/deux.py" "$d" 2>&1)
attendu="A crée : p.grym Bonjour ana Ta couleur ? Envoyer Annuler
B page : p.grym Nom d&#39;utilisateur ? Mot de passe ? Envoyer Annuler
B se connecte : p.grym Bonjour ana Ta couleur ? Envoyer Annuler
A répond : p.grym Bonjour ana Couleur de ana : rouge Application terminée. Tu peux fermer cet onglet.
B répond : p.grym Bonjour ana Couleur de ana : vert Application terminée. Tu peux fermer cet onglet.
sans cookie : 403  mauvais jeton : 403
A revient : p.grym Nom d&#39;utilisateur ? Mot de passe ? Envoyer Annuler
autre hôte : 403
autre origine : 403"
# --base : les sessions ouvrent la base imposée (celle d'une application fabriquée), pas celle d'à côté du programme
kill $pid 2> /dev/null; wait $pid 2> /dev/null
mkdir donnees
GRYM_UTILISATEUR=ana GRYM_MOT_DE_PASSE_UTILISATEUR=secret123 "$grym" servir p.grym --sessions --base "$d/donnees/app.grymd" --sans-navigateur > ag.txt 2>&1 < /dev/null &
pid=$!
n=0
while ! grep -q 'jeton=' ag.txt 2> /dev/null && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
python3 - "$d" <<'FIN' > base.txt 2>&1
import http.client, re, sys
port, jeton = re.search(r'127\.0\.0\.1:(\d+)/\?jeton=([0-9a-f]+)', open(sys.argv[1] + '/ag.txt').read()).groups()
def req(c, ck=None):
    x = http.client.HTTPConnection('127.0.0.1', int(port), timeout=30)
    h = {'Host': f'127.0.0.1:{port}'}
    if ck: h['Cookie'] = ck
    x.request('GET', c, headers=h); r = x.getresponse(); return dict(r.getheaders()), r.read().decode()
h, b = req('/?jeton=' + jeton); h, b = req('/', h['Set-Cookie'].split(';')[0])
print('Bonjour ana' in b)
FIN
[ "$(cat base.txt)" = "True" ] && [ -f donnees/app.grymd ] || { echo "ÉCHEC : --base (la session n'a pas ouvert la base imposée)"; cat base.txt ag.txt; exit 1; }
if [ "$obtenu" = "$attendu" ]; then echo "2/2 tests réussis"; exit 0; fi
echo "ÉCHEC : deux navigateurs"; echo "attendu :"; echo "$attendu"; echo "obtenu :"; echo "$obtenu"; echo "aiguilleur :"; cat ag.txt
exit 1
