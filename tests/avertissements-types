#!/bin/sh
# Les avertissements de types (grammaire 3.33) : l'analyse déduit le type d'une variable (sa création, son nom
# d'entité), d'un champ, d'une zone d'écran, d'une recherche, et avertit d'une lecture qui échouerait à l'exécution :
# le champ d'une valeur (la faute de la 3.31), un champ qu'aucune entité de la famille n'a. Aucun refus. Puis aucun
# avertissement de ce genre sur les vrais programmes du dépôt : un faux avertissement est une régression.
racine=$(cd "$(dirname "$0")/.." && pwd)
grym="$racine/grym"
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
total=0; echecs=0
verifier() { total=$((total + 1)); if [ "$1" != "$2" ]; then echecs=$((echecs + 1)); echo "ÉCHEC : $3 (attendu « $2 », obtenu « $1 »)"; fi; }
cd "$d" || exit 1
cat > av.grym <<'FIN'
Une facture, conservée, a :
    un numéro (texte),
    un montant (nombre).
Une personne, conservée, a :
    un nom (texte),
    un âge (nombre).
L'écran x montre :
    une période (nombre), facultative.
L'année des comptes vaut 2026.
Afficher la période de l'année des comptes.
La f vaut la facture conservée dont le numéro est « F1 ».
Afficher l'âge de la f.
Pour régler une facture :
    Afficher le montant de la facture.
    Afficher le nom de la facture.
Le texte vaut « abc ».
Afficher la longueur du texte.
Le n vaut 3.
Afficher le montant du n.
Pour chaque personne conservée :
    Afficher le montant de la personne.
FIN
"$grym" compiler av.grym > /dev/null 2> sortie.txt
verifier "$?" "0" "les avertissements ne refusent rien"
verifier "$(grep -c avertissement sortie.txt)" "5" "cinq avertissements"
verifier "$(grep -c 'av.grym:10:10 : avertissement : « période » se lit ici comme le champ d.une valeur (nombre entier)' sortie.txt)" "1" "le champ d'une valeur"
verifier "$(grep -c 'av.grym:12:10 : avertissement : « âge » n.est pas un champ de la facture' sortie.txt)" "1" "un champ hors de la famille"
verifier "$(grep -c 'av.grym:15:14 : avertissement : « nom » n.est pas un champ de la facture' sortie.txt)" "1" "un paramètre nommé comme son entité"
verifier "$(grep -c 'av.grym:19:10 : avertissement : « montant » se lit ici comme le champ d.une valeur' sortie.txt)" "1" "une variable créée par un nombre"
verifier "$(grep -c 'av.grym:21:14 : avertissement : « montant » n.est pas un champ de la personne' sortie.txt)" "1" "une variable de boucle"
# 3.34 : le type que rend un calcul, un paramètre nommé comme un type de base, les comparaisons impossibles
cat > av3.grym <<'FIN'
Une facture, conservée, a :
    un numéro (texte),
    un montant (nombre),
    une échéance (date).
Une personne, conservée, a :
    un nom (texte).
Le double d'un nombre vaut nombre × 2.
La dernière d'une référence :
    Rendre la facture conservée dont le numéro est référence.
La relance d'une facture vaut l'échéance de la facture + 30.
Afficher le montant du double de 3.
Afficher le montant de la dernière de « F1 ».
Afficher le nom de la dernière de « F1 ».
Afficher le jour de la relance de la dernière de « F1 ».
Afficher le montant de la relance de la dernière de « F1 ».
FIN
"$grym" compiler av3.grym > /dev/null 2> s3.txt
verifier "$(grep -c avertissement s3.txt)" "3" "trois avertissements par des calculs typés"
verifier "$(grep -c 'av3.grym:11:10 : avertissement : « montant » se lit ici comme le champ d.une valeur (nombre)' s3.txt)" "1" "le calcul « double » rend un nombre"
verifier "$(grep -c 'av3.grym:13:10 : avertissement : « nom » n.est pas un champ de la facture' s3.txt)" "1" "le calcul « dernière » rend une facture"
verifier "$(grep -c 'av3.grym:15:10 : avertissement : « montant » se lit ici comme le champ d.une valeur (date)' s3.txt)" "1" "une date plus un nombre est une date"
cat > av4.grym <<'FIN'
Une facture, conservée, a :
    un numéro (texte),
    un montant (nombre),
    une échéance (date),
    un payé (vrai ou faux).
La f vaut la facture conservée dont le numéro est « F1 ».
Le double d'un nombre vaut nombre × 2.
Si le numéro de la f = le montant de la f, afficher 1.
Si le numéro de la f < « F2 », afficher 2.
Si l'échéance de la f > 3, afficher 3.
Si le double de 4 = « x », afficher 4.
Si le montant de la f ≥ le double de 4, afficher 5.
Si l'échéance de la f < aujourd'hui, afficher 6.
Si la f = la f, afficher 7.
Si l'année d'aujourd'hui = 2026, afficher 8.
FIN
"$grym" compiler av4.grym > /dev/null 2> s4.txt
verifier "$(grep -c avertissement s4.txt)" "4" "quatre comparaisons impossibles"
verifier "$(grep -c 'av4.grym:8:22 : avertissement : Ici, un texte se compare à un nombre' s4.txt)" "1" "un texte et un nombre"
verifier "$(grep -c 'av4.grym:9:22 : avertissement : Seuls des nombres, des dates ou des heures se comparent par ordre : ici, des textes.' s4.txt)" "1" "un ordre entre textes"
verifier "$(grep -c 'av4.grym:10:23 : avertissement : Ici, une date se compare à un nombre' s4.txt)" "1" "une date et un nombre"
verifier "$(grep -c 'av4.grym:11:19 : avertissement : Ici, un nombre se compare à un texte' s4.txt)" "1" "le résultat d'un calcul et un texte"
# 3.35 : plusieurs lectures. Un paramètre prend le type de tous les arguments de ses appels, même écrits après lui ; une
# variable globale, celui de toutes les valeurs qu'elle reçoit ; une action qui rend, le type de ses « Rendre ». Un
# désaccord, une formule à plusieurs versions : rien. Une condition « dont » garde sa propre vérification.
cat > av5.grym <<'FIN'
Une facture, conservée, a :
    un numéro (texte),
    un montant (nombre).
Une personne, conservée, a :
    un nom (texte).
La pièce en cours vaut absente.
Pour régler une pièce :
    Afficher le nom de la pièce.
Pour montrer :
    Afficher le nom de la pièce en cours.
Pour fabriquer :
    La x vaut une nouvelle facture :
        Le numéro vaut « F1 ».
        Le montant vaut 10.
    Rendre la x.
Pour vérifier une limite (nombre) :
    Afficher le montant de la limite.
Pour saluer un invité :
    Afficher le nom de l'invité.
Pour noter un a et un b :
    Afficher le montant du a.
Fabriquer, qui donne la q.
Afficher le nom de la q.
Si la longueur du numéro de la q = « a », afficher 1.
Régler la q.
La pièce en cours devient la q.
Saluer la q.
Saluer la personne conservée dont le nom est « Ana ».
Noter 1 et 2.
Noter la q et 2.
Pour chaque facture conservée dont le numéro ≥ « F- » et le numéro < « G », afficher le montant de la facture.
FIN
"$grym" compiler av5.grym > /dev/null 2> s5.txt
verifier "$?" "0" "3.35 : rien n'est refusé"
verifier "$(grep -c avertissement s5.txt)" "5" "cinq avertissements par les indices"
verifier "$(grep -c 'av5.grym:8:14 : avertissement : « nom » n.est pas un champ de la facture' s5.txt)" "1" "un paramètre typé par son appel, écrit plus bas"
verifier "$(grep -c 'av5.grym:10:14 : avertissement : « nom » n.est pas un champ de la facture' s5.txt)" "1" "une variable globale typée par sa valeur, écrite plus bas"
verifier "$(grep -c 'av5.grym:17:14 : avertissement : « montant » se lit ici comme le champ d.une valeur (nombre)' s5.txt)" "1" "un paramètre annoté (nombre)"
verifier "$(grep -c 'av5.grym:23:10 : avertissement : « nom » n.est pas un champ de la facture' s5.txt)" "1" "ce que rend une action, « qui donne la q »"
verifier "$(grep -c 'av5.grym:24:34 : avertissement : Ici, un nombre se compare à un texte' s5.txt)" "1" "la longueur d'un texte est un nombre"
cat > av6.grym <<'FIN'
Une facture, conservée, a :
    un numéro (texte).
Une personne, conservée, a :
    un nom (texte).
Pour classer une facture :
    Afficher le numéro de la facture.
Pour classer une personne :
    Afficher le nom de la personne.
La f vaut la facture conservée dont le numéro est « F1 ».
Classer la f.
FIN
"$grym" compiler av6.grym > /dev/null 2> s6.txt
verifier "$(grep -c avertissement s6.txt)" "0" "une formule à deux versions ne prend pas le type de ses appels"
# 3.36 : un champ intégré lu sur une valeur qui ne l'a pas (la longueur d'un nombre, l'année d'un texte…) ; ceux qu'elle
# a vraiment ne disent rien.
cat > av7.grym <<'FIN'
Une facture, conservée, a :
    un numéro (texte),
    un montant (nombre),
    une échéance (date),
    un payé (vrai ou faux),
    une pièce (fichier), facultative.
La f vaut la facture conservée dont le numéro est « F1 ».
Afficher la longueur du montant de la f.
Afficher l'année du numéro de la f.
Afficher la longueur de l'échéance de la f.
Afficher la taille du payé de la f.
Afficher le mois de la pièce de la f.
Afficher la longueur du numéro de la f.
Afficher la valeur absolue du montant de la f.
Afficher le jour de la semaine de l'échéance de la f.
Afficher la taille de la pièce de la f.
Afficher l'année de l'échéance de la f.
Le a vaut l'année de 21.09.2026.
Afficher le mois du a.
Le h vaut 14:30.
Afficher le jour du h.
FIN
"$grym" compiler av7.grym > /dev/null 2> s7.txt
verifier "$(grep -c avertissement s7.txt)" "7" "sept champs intégrés mal placés"
verifier "$(grep -c 'av7.grym:8:10 : avertissement : « longueur » se lit ici sur un nombre, qui n.a pas ce champ (seulement « valeur absolue » et « partie entière »)' s7.txt)" "1" "la longueur d'un nombre"
verifier "$(grep -c 'av7.grym:9:10 : avertissement : « année » se lit ici sur un texte' s7.txt)" "1" "l'année d'un texte"
verifier "$(grep -c 'av7.grym:10:10 : avertissement : « longueur » se lit ici sur une date' s7.txt)" "1" "la longueur d'une date"
verifier "$(grep -c 'av7.grym:11:10 : avertissement : « taille » se lit ici sur vrai ou faux, qui n.a aucun champ' s7.txt)" "1" "la taille d'un vrai ou faux"
verifier "$(grep -c 'av7.grym:12:10 : avertissement : « mois » se lit ici sur un fichier' s7.txt)" "1" "le mois d'un fichier"
verifier "$(grep -c 'av7.grym:19:10 : avertissement : « mois » se lit ici sur une année, qui n.a aucun champ' s7.txt)" "1" "le mois d'une année"
verifier "$(grep -c 'av7.grym:21:10 : avertissement : « jour » se lit ici sur une heure, qui n.a aucun champ' s7.txt)" "1" "le jour d'une heure"
# 3.37 : une valeur au type déduit rangée dans un champ qui la refuserait toujours ; ce qui dépend de la valeur (un nombre
# dans un nombre entier, un texte dans un courriel, une personne dans un lien vers un membre) se tait.
cat > av8.grym <<'FIN'
Une personne, conservée, a :
    un nom (texte),
    un courriel (courriel), facultatif.
Un membre, conservé, est une personne.
Un membre a :
    une cotisation (nombre).
Une facture, conservée, a :
    un numéro (texte),
    un montant (nombre),
    un rang (nombre entier),
    une échéance (date), facultative,
    un patient (personne), facultatif,
    un payeur (membre), facultatif.
Le t vaut « abc ».
Le p vaut la personne conservée dont le nom est « Ana ».
Le m vaut le membre conservé dont le nom est « Bob ».
La f vaut une nouvelle facture :
    Le numéro vaut « F1 ».
    Le montant vaut le t.
    Le rang vaut 2.
Le montant de la f devient le t.
L'échéance de la f devient le p.
Le numéro de la f devient le p.
Le patient de la f devient le t.
Le rang de la f devient le montant de la f × 1,5.
Le courriel du p devient le t.
Le patient de la f devient le m.
Le payeur de la f devient le p.
Le numéro de la f devient le nom du p.
Le montant de la f devient le rang de la f + 1.
FIN
"$grym" compiler av8.grym > /dev/null 2> s8.txt
verifier "$(grep -c avertissement s8.txt)" "5" "cinq écritures impossibles"
verifier "$(grep -c 'av8.grym:19:21 : avertissement : Ici, le champ « montant » reçoit un texte, alors qu.il attend un nombre' s8.txt)" "1" "dans le bloc d'un nouvel objet"
verifier "$(grep -c 'av8.grym:21:28 : avertissement : Ici, le champ « montant » reçoit un texte' s8.txt)" "1" "par « devient »"
verifier "$(grep -c 'av8.grym:22:28 : avertissement : Ici, le champ « échéance » reçoit une personne, alors qu.il attend une date' s8.txt)" "1" "un objet dans une date"
verifier "$(grep -c 'av8.grym:23:27 : avertissement : Ici, le champ « numéro » reçoit une personne' s8.txt)" "1" "un objet dans un texte"
verifier "$(grep -c 'av8.grym:24:28 : avertissement : Ici, le champ « patient » reçoit un texte, alors qu.il attend une personne' s8.txt)" "1" "un texte dans un lien"
# 3.38 : un paramètre nommé comme une entité (« une prise », la prise d'un poste, quand une entité « prise » existe) : ses
# appels disent son type ; des textes, ou un texte et une valeur inconnue, contredisent le nom, qui se tait.
cat > av9.grym <<'FIN'
Une prise, conservée, a :
    une contrée (texte).
Un modèle, conservé, a :
    une connectique (texte), facultative,
    un socle (prise), facultatif.
Le m vaut le modèle conservé dont la connectique est « x ».
Pour cataloguer une prise :
    La connectique du m devient la prise.
Pour brancher une prise :
    La connectique du m devient la prise.
Pour raccorder une prise :
    Le socle du m devient la prise.
    La connectique du m devient la prise.
Cataloguer « jack ».
Cataloguer (absent).
Brancher « jack ».
Brancher le champ « a » de (la lecture de « http://exemple.ch »).
Raccorder la prise conservée dont la contrée est « Suisse ».
FIN
"$grym" compiler av9.grym > /dev/null 2> s9.txt
verifier "$(grep -c avertissement s9.txt)" "1" "seul l'appel avec une vraie prise avertit"
verifier "$(grep -c 'av9.grym:13:33 : avertissement : Ici, le champ « connectique » reçoit une prise' s9.txt)" "1" "le nom confirmé par l'appel"
for f in "Praxis/Nicolas/Praxis.grym" "Praxis/Nicolas/actions.grym" "Praxis/Test de charge/charge.grym" "Écoutille/Écoutille.grym" "Gestion de projet/Gestion de projet.grym"; do
    dir="$racine/projets/$(dirname "$f")"; b=$(basename "$f")
    mkdir -p "$d/p" && cp -R "$dir/." "$d/p/" && (cd "$d/p" && "$grym" compiler "$b" > /dev/null 2> sortie.txt)
    verifier "$(grep -c 'avertissement' "$d/p/sortie.txt")" "0" "aucun faux avertissement : $f"
    rm -rf "$d/p"
done
mkdir -p "$d/g" && cp -R "$racine/docs/guide/." "$d/g/" && (cd "$d/g" && "$grym" compiler chapitre-08.grym > /dev/null 2> sortie.txt)
verifier "$(grep -c 'avertissement' "$d/g/sortie.txt")" "0" "un ordre entre textes dans une condition « dont » : le guide, chapitre 8"
echo "$((total - echecs))/$total tests réussis"
[ "$echecs" -eq 0 ]
