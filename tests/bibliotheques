#!/bin/sh
# Les bibliothèques (grammaire 2.61, § 21.9, 26 octobre 2026) : « Utiliser la bibliothèque « X », version N. » trouve
# bibliothèques/X/bibliothèque.grym à côté du programme ; version exacte, une seule par application ; ni entité ni
# règle ; ses fichiers restent dans son dossier ; un programme n'y entre pas par un chemin. Ses fichiers internes (2.62)
# ne montrent leurs formules qu'à elle ; elle déclare des XML à valeurs (2.63).
racine=$(cd "$(dirname "$0")/.." && pwd)
grym="$racine/grym"
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
cd "$d" || exit 1
total=0; echecs=0
verifier() { total=$((total + 1)); if [ "$1" != "$2" ]; then echecs=$((echecs + 1)); echo "ÉCHEC : $3 (attendu « $2 », obtenu « $1 »)"; fi; }
contient() { total=$((total + 1)); case "$1" in *"$2"*) ;; *) echecs=$((echecs + 1)); echo "ÉCHEC : $3 (« $2 » attendu dans « $1 »)";; esac; }
S="bibliothèques/Suisse santé"
mkdir -p "$S" "bibliothèques/Banque" "bibliothèques/Monnaie"
entree() {
    printf 'Remarque : outils suisses.\nCette bibliothèque est « Suisse santé », version 2.\nUtiliser « arrondis ».\n\nUne chose tarifée a :\n    un montant (nombre).\n\nLe total arrondi d'"'"'un montant vaut le centime suisse du montant.\n' > "$S/bibliothèque.grym"
}
entree
printf 'Le centime suisse d'"'"'un x vaut l'"'"'arrondi de x à 0,05.\n' > "$S/arrondis.grym"
programme() { printf 'Utiliser la bibliothèque « Suisse santé », version %s.\nUne facture, conservée, est une chose tarifée.\nAfficher le total arrondi de 12,33.\n' "$1" > p.grym; }
lancer() { "$grym" lancer p.grym 2>&1 < /dev/null; }

programme 2
verifier "$(lancer)" "12,35" "la bibliothèque s'utilise"
"$grym" traduire p.grym > /dev/null 2>&1
verifier "$(head -1 p.grymc)" "_utiliser _bibliothèque « Suisse santé » 2" "forme compacte de la phrase"
mv p.grym p0.grym
"$grym" traduire p.grymc > /dev/null 2>&1
verifier "$(cmp -s p.grym p0.grym && echo pareil)" "pareil" "aller-retour par la forme compacte"
rm -f p.grymc p0.grym
(cd "$S" && "$grym" traduire bibliothèque.grym > /dev/null 2>&1)
verifier "$(sed -n 2p "$S/bibliothèque.grymc")" "_bibliothèque « Suisse santé » 2" "forme compacte de la déclaration"
rm -f "$S/bibliothèque.grymc"
verifier "$(cd "$S" && "$grym" lancer bibliothèque.grym 2>&1 < /dev/null; echo $?)" "0" "la bibliothèque ouverte seule"

programme 3
contient "$(lancer)" "est en version 2 ; le programme demande la version 3" "version différente"
printf 'Utiliser la bibliothèque « Suisse santé ».\n' > p.grym
contient "$(lancer)" "La version suit le nom" "version absente"
printf 'Utiliser la bibliothèque « Inconnue », version 1.\n' > p.grym
contient "$(lancer)" "il manque « bibliothèques/Inconnue/bibliothèque.grym »" "bibliothèque introuvable"
printf 'Utiliser « bibliothèques/Suisse santé/arrondis ».\nAfficher 1.\n' > p.grym
contient "$(lancer)" "appartient à une bibliothèque" "pas d'entrée par un chemin"
printf 'Cette bibliothèque est « X », version 1.\nLe deux vaut 2.\n' > commun.grym
printf 'Utiliser « commun ».\nAfficher le deux.\n' > p.grym
contient "$(lancer)" "se déclare bibliothèque" "un fichier ordinaire ne se déclare pas bibliothèque"
printf 'Utiliser la bibliothèque « Suisse santé », version 2.\nLe centime suisse d'"'"'un x vaut x.\nAfficher 1.\n' > p.grym
contient "$(lancer)" "existe déjà : déclaré dans « bibliothèques/Suisse santé/arrondis.grym »" "aucun nom remplacé en silence"

programme 2
printf 'Cette bibliothèque est « Suisse santé », version 2.\nUn patient, conservé, a :\n    un nom (texte).\n' > "$S/bibliothèque.grym"
contient "$(lancer)" "Une bibliothèque ne déclare pas d'entité" "pas d'entité"
printf 'Cette bibliothèque est « Suisse », version 2.\n' > "$S/bibliothèque.grym"
contient "$(lancer)" "s'y déclare « Suisse »" "le nom du dossier"
printf 'Remarque : rien.\n' > "$S/bibliothèque.grym"
contient "$(lancer)" "doit commencer par « Cette bibliothèque est" "la déclaration en tête"
printf 'Cette bibliothèque est « Suisse santé », version 2.\nCette bibliothèque est « Suisse santé », version 2.\n' > "$S/bibliothèque.grym"
contient "$(lancer)" "une seule fois" "une seule déclaration"
printf 'Cette bibliothèque est « Suisse santé », version 2.\nUtiliser « ../../commun ».\n' > "$S/bibliothèque.grym"
contient "$(lancer)" "n'utilise que ses propres fichiers" "les fichiers restent dans son dossier"

# une seule version par application : Banque demande Monnaie 1, le programme Monnaie 2
entree
printf 'Cette bibliothèque est « Monnaie », version 2.\nLe franc d'"'"'un x vaut x.\n' > bibliothèques/Monnaie/bibliothèque.grym
printf 'Cette bibliothèque est « Banque », version 1.\nUtiliser la bibliothèque « Monnaie », version 2.\nLe solde d'"'"'un x vaut le franc de x.\n' > bibliothèques/Banque/bibliothèque.grym
printf 'Utiliser la bibliothèque « Monnaie », version 2.\nUtiliser la bibliothèque « Banque », version 1.\nAfficher le solde de 4.\n' > p.grym
verifier "$(lancer)" "4" "deux bibliothèques, la même version partagée"
printf 'Cette bibliothèque est « Banque », version 1.\nUtiliser la bibliothèque « Monnaie », version 1.\n' > bibliothèques/Banque/bibliothèque.grym
contient "$(lancer)" "déjà utilisée en version 2" "deux versions d'une même bibliothèque"
# les fichiers internes (2.62) : leurs formules ne se voient que dans la bibliothèque
entree
printf 'Remarque : outils.\nCe fichier est interne à sa bibliothèque.\n\nLe centime suisse d'"'"'un x vaut l'"'"'arrondi de x à 0,05.\n\nPour tracer un x :\n    Afficher « trace » puis x.\n' > "$S/arrondis.grym"
programme 2
verifier "$(lancer)" "12,35" "l'entrée emploie son fichier interne"
printf 'Utiliser la bibliothèque « Suisse santé », version 2.\nAfficher le centime suisse de 12,33.\n' > p.grym
contient "$(lancer)" "« centime suisse » est interne à la bibliothèque « Suisse santé »" "un calcul interne caché"
printf 'Utiliser la bibliothèque « Suisse santé », version 2.\nTracer 4.\n' > p.grym
contient "$(lancer)" "« tracer » est interne à la bibliothèque « Suisse santé »" "une action interne cachée"
printf 'Utiliser la bibliothèque « Suisse santé », version 2.\nAfficher le centime suise de 12,33.\n' > p.grym
total=$((total + 1)); case "$(lancer)" in *voulais-tu*) echecs=$((echecs + 1)); echo "ÉCHEC : une suggestion montre un nom interne";; esac
(cd "$S" && "$grym" traduire arrondis.grym > /dev/null 2>&1)
verifier "$(sed -n 2p "$S/arrondis.grymc")" "_interne" "forme compacte de l'interne"
rm -f "$S/arrondis.grymc"
verifier "$(cd "$S" && "$grym" lancer arrondis.grym > /dev/null 2>&1 < /dev/null; echo $?)" "0" "un fichier interne ouvert seul"
printf 'Ce fichier est interne à sa bibliothèque.\nUne chose tarifée a :\n    un montant (nombre).\n' > "$S/arrondis.grym"
contient "$(lancer)" "Un fichier interne ne déclare que des calculs et des actions" "ni classe ni aptitude interne"
printf 'Cette bibliothèque est « Suisse santé », version 2.\nCe fichier est interne à sa bibliothèque.\n' > "$S/bibliothèque.grym"
contient "$(lancer)" "L'entrée d'une bibliothèque n'est pas interne" "l'entrée n'est pas interne"
printf 'Ce fichier est interne à sa bibliothèque.\nLe un d'"'"'un x vaut 1.\n' > commun.grym
printf 'Utiliser « commun ».\n' > p.grym
contient "$(lancer)" "n'appartient à aucune bibliothèque" "l'interne hors d'une bibliothèque"
# le XML à valeurs (2.63) : déclaré pour une aptitude dans la bibliothèque, rempli par l'entité du programme
entree
printf '\nLe XML de quittance d'"'"'une chose tarifée, « quittance », montre :\n    l'"'"'attribut « montant » : le montant de la chose.\n' >> "$S/bibliothèque.grym"
printf 'Le centime suisse d'"'"'un x vaut l'"'"'arrondi de x à 0,05.\n' > "$S/arrondis.grym"
printf 'Utiliser la bibliothèque « Suisse santé », version 2.\nUne facture, conservée, est une chose tarifée.\nLa f vaut une nouvelle facture :\n    Le montant vaut 12,5.\nEnregistrer le XML de quittance de la f dans « q.xml ».\n' > p.grym
lancer > /dev/null
verifier "$(sed -n 2p q.xml 2>/dev/null)" '<quittance montant="12.5"/>' "le XML d'une bibliothèque, rempli par le programme"
"$grym" traduire p.grym > /dev/null 2>&1
verifier "$(grep -c '_xml quittance(f)' p.grymc)" "1" "forme compacte de l'appel"
mv p.grym p0.grym; "$grym" traduire p.grymc > /dev/null 2>&1
verifier "$(cmp -s p.grym p0.grym && echo pareil)" "pareil" "aller-retour du XML à valeurs"
rm -f p.grymc p0.grym q.xml
(cd "$S" && "$grym" traduire bibliothèque.grym > /dev/null 2>&1)
verifier "$(grep -c '_xml quittance(_une chose_tarifée) « quittance »' "$S/bibliothèque.grymc")" "1" "forme compacte de la déclaration"
(cd "$S" && mv bibliothèque.grym b0 && "$grym" traduire bibliothèque.grymc > /dev/null 2>&1)
verifier "$(cmp -s "$S/bibliothèque.grym" "$S/b0" && echo pareil)" "pareil" "aller-retour de la déclaration"
mv "$S/b0" "$S/bibliothèque.grym"; rm -f "$S/bibliothèque.grymc"
printf 'Utiliser la bibliothèque « Suisse santé », version 2.\nLe x vaut le XML de quittance.\n' > p.grym
contient "$(lancer)" "Le XML de quittance attend sa valeur" "le XML sans sa valeur"
printf 'Le XML de bon d'"'"'un x, « bon », montre :\n    le contenu : x.\n' > d.grym
printf 'Utiliser « d ».\nEnregistrer le XML de bon de 3 dans « b.xml ».\n' > p.grym
lancer > /dev/null
verifier "$(sed -n 2p b.xml 2>/dev/null)" "<bon>3</bon>" "un XML déclaré dans un fichier utilisé"
echo "$((total - echecs))/$total tests réussis"
[ "$echecs" -eq 0 ]
