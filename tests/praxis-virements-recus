#!/bin/sh
# Les virements reçus de Praxis (4 novembre 2026) : un avis de crédit camt.054 (lu deux fois, rien en double) et un relevé
# camt.053, lus comme XML par « le champ » (grammaire 2.84) ; chaque crédit rapproché d'une facture par sa référence du créancier
# (SCOR) ou par le numéro de pièce de son message, au jour du virement ; les montants qui ne collent pas, à vérifier ; la
# QR-facture porte la référence RF de sa facture ; une fiche semblable signalée à l'inscription (tests/praxis/virements-recus.grym).
racine=$(cd "$(dirname "$0")/.." && pwd)
grym="$racine/grym"
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
N="$racine/projets/Praxis/Nicolas"
cp "$N/données.grym" "$N/actions.grym" "$d/" && cp -R "$N/bibliothèques" "$d/"
cp "$racine/tests/praxis/virements-recus.grym" "$racine/tests/praxis/avis-camt054.xml" "$racine/tests/praxis/releve-camt053.xml" "$d/"
cd "$d" || exit 1
total=0; echecs=0
verifier() { total=$((total + 1)); if [ "$1" != "$2" ]; then echecs=$((echecs + 1)); echo "ÉCHEC : $3 (attendu « $2 », obtenu « $1 »)"; fi; }
sortie="$("$grym" lancer virements-recus.grym 2>&1 < /dev/null)"
ligne() { echo "$sortie" | sed -n "$1p"; }
verifier "$(ligne 28)" "SCOR" "la QR-facture porte une référence du créancier"
verifier "$(ligne 29)" "RF12F20260001" "la référence RF de F-2026-0001, celle aussi de son rappel (ISO 11649, contrôle 12)"
verifier "$(ligne 30)" "Rappel F-2026-0001" "le motif reste écrit pour le payeur"
verifier "$(ligne 32)" "4" "quatre crédits : le débit ignoré, l'avis relu n'ajoute rien"
verifier "$(ligne 33)" "BQ-002/1|03.11.2026|200,00|rapproché||" "une écriture groupée : le premier virement, par le numéro du message (« Rappel F-2026-0002, merci »)"
verifier "$(ligne 34)" "BQ-002/2|03.11.2026|50,00|à vérifier|CHF 50,00 reçus ; la facture F-2026-0003 attend CHF 80,00.|Bernard Dupuis" "un acompte reste à vérifier, avec sa raison et son payeur"
verifier "$(ligne 35)" "BQ-004/1|03.11.2026|35,00|à vérifier|Aucune facture ne porte cette référence ni ce numéro : choisis-la, ou écarte ce virement.|" "sans détail, sa date de valeur ; rien à rapprocher"
verifier "$(ligne 36)" "TX-001|02.11.2026|120,00|rapproché||Anne Rochat" "par la référence SCOR, au jour de comptabilisation"
verifier "$(ligne 37)" "F-2026-0001|réglée" "la facture référencée est réglée"
verifier "$(ligne 38)" "F-2026-0002|réglée" "la facture du message est réglée"
verifier "$(ligne 39)" "F-2026-0003|à régler" "un montant qui ne colle pas ne règle rien"
verifier "$(ligne 41)" "120|virement|02.11.2026" "la séance encaissée au jour du virement"
verifier "$(ligne 43)" "réglée" "attribuer à la main solde la facture"
verifier "$(ligne 44)" "REL-001/1|03.11.2026|80,00|rapproché|" "un relevé camt.053 : la facture tiers payant, par son numéro, son moment ramené au jour"
verifier "$(ligne 45)" "REL-002/1|03.11.2026|10,00|à vérifier|Un virement en EUR : Praxis facture en CHF." "une autre monnaie reste à vérifier"
verifier "$(ligne 46)" "réglé|03.11.2026" "la facture tiers payant réglée au jour du virement"
verifier "$(ligne 47)" "« Anne Rochat » a déjà ce courriel" "le même courriel, sans égard à la casse"
verifier "$(ligne 48)" "« Anne Rochat » a déjà ce natel" "le même natel, écrit autrement"
verifier "$(ligne 49)" "« Anne Rochat » porte ce nom de famille, avec la même date de naissance" "le même nom de famille, né le même jour"
verifier "$(ligne 50)" "[]" "une autre personne : rien"
echo "$((total - echecs))/$total tests réussis"
[ $echecs = 0 ]
