#!/bin/sh
# Les scénarios de Drogman (17 novembre 2026, grammaire § 9.7) : projets/Drogman/scenarios.grym, joués par
# « grym scenarios » sur une copie du projet, chacun sur une base neuve en mémoire. Ils gardent ce qui ne demande ni Whisper
# ni Google : les segments versés en tours, la version COREL proposée, les sigles, la correction d'un tour, le document
# COREL en RTF, le texte pour NVivo, les refus. Un échec arrête « ./appliquer ».
racine=$(cd "$(dirname "$0")/.." && pwd)
grym="$racine/grym"
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
cp -R "$racine/projets/Drogman/." "$d/" || exit 1
cd "$d" || exit 1
# la forme (18 novembre 2026) : canonique (« grym formater » ne change rien), et l'aller-retour par la forme compacte se
# compile. tests/formes l'éprouve aussi, mais seulement là où l'atelier a posé son projet.grymatelier : sur le Mac de
# Flaggstaff, pas dans un clone frais, d'où des patchs qui passaient ici et pas chez lui.
for f in Drogman.grym scenarios.grym; do
    "$grym" formater "$f" 2> /dev/null | tr -d '\r' > "$d/canon"
    cmp -s "$d/canon" "$racine/projets/Drogman/$f" || { echo "Drogman/$f n'est pas en forme canonique : lance « grym formater » dessus."; exit 1; }
done
mkdir "$d/aller" && cp Drogman.grym "$d/aller/" && (cd "$d/aller" && "$grym" traduire Drogman.grym > /dev/null 2>&1 && rm Drogman.grym \
    && "$grym" traduire Drogman.grymc > /dev/null 2>&1 && rm Drogman.grymc && "$grym" compiler Drogman.grym > /dev/null 2> "$d/err") \
    || { echo "Drogman, revenu de la forme compacte, ne se compile plus : $(head -c 300 "$d/err" 2> /dev/null)"; exit 1; }
rm -rf "$d/aller" "$d/canon"
if sortie="$("$grym" scenarios scenarios.grym 2>&1 < /dev/null)"; then
    echo "$sortie" | tail -1
    exit 0
fi
echo "$sortie" | grep -E "✗|scénarios?,|erreur"
echo
echo "Un scénario de Drogman ne passe plus (projets/Drogman/scenarios.grym)."
echo "- Si Drogman a reçu un champ obligatoire, complète l'action d'aide « Poser » en tête du fichier."
echo "- Sinon, un comportement a changé : vérifie que c'est voulu avant de modifier le scénario."
exit 1
