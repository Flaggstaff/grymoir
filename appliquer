#!/bin/sh
# GrymoiR : appliquer un patch reçu, vérifier, publier, puis relancer l'atelier.
#   ./appliquer ~/Downloads/grymoir-t2.patch
# Si le patch ne s'applique pas, ou si un essai échoue, rien n'est publié et le dépôt reste tel qu'il était.
set -e
depot="$(cd "$(dirname "$0")" && pwd)"
[ -n "$1" ] || { echo "Usage : ./appliquer chemin/du/fichier.patch" >&2; exit 1; }
[ -f "$1" ] || { echo "Patch introuvable : $1" >&2; exit 1; }
patch="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
cd "$depot"

if [ -d .git/rebase-apply ]; then
    echo "Un patch précédent était resté à moitié appliqué : je l'abandonne."
    git am --abort
fi
# l'autre ordinateur a peut-être publié : on le récupère d'abord, en avance rapide seulement (22 octobre 2026)
if ! git pull -q --ff-only; then
    echo "GitHub injoignable, ou le dépôt local a divergé de GitHub (des commits ou des modifications des deux côtés) : rien n'a changé." >&2
    echo "Le dépôt est à : $(git log --oneline -1)" >&2
    exit 1
fi
avant="$(git rev-parse HEAD)"
if ! git am "$patch"; then
    git am --abort
    echo "Le patch ne s'applique pas : rien n'a changé. Le dépôt est à : $(git log --oneline -1)" >&2
    # le diagnostic le plus fréquent (23 octobre 2026) : le patch est déjà là, ou il en manque un avant lui
    sujet="$(sed -n 's/^Subject: \[PATCH[^]]*\] //p' "$patch" | head -1 | cut -c1-60)"
    if [ -n "$sujet" ] && git log -20 --format=%s | cut -c1-60 | grep -qxF "$sujet"; then
        echo "Ce patch est déjà appliqué (son commit est dans les 20 derniers) : rien à faire." >&2
    else
        echo "Il en manque sans doute un avant lui : applique d'abord, dans l'ordre, ceux que tu n'as pas encore appliqués" >&2
        echo "(ls -t ~/Downloads/*.patch | head montre les derniers reçus)." >&2
    fi
    exit 1
fi

echo "Construction et essais…"
if ! ./atelier --construire || ! make -s test || ! ctest --test-dir construction --output-on-failure; then
    git reset -q --hard "$avant"
    echo "Échec de la construction ou d'un essai : le patch est retiré, rien n'est publié." >&2
    echo "Envoie-moi ce qui s'est affiché ci-dessus." >&2
    exit 1
fi

git push
exec "$depot/atelier"
