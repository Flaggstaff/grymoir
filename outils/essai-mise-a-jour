#!/bin/sh
# Essayer la mise à jour de Praxis sur une COPIE de la base d'un cabinet, avant de l'installer (23 octobre 2026).
#
#   outils/essai-mise-a-jour <dossier de la base> [cabinet]
#
# <dossier de la base> : un dossier qui contient la base copiée depuis l'ordinateur du cabinet (Praxis.grymd et son fichier de
# clés Praxis.grymd.clés ; sous macOS, l'original est dans ~/Library/Application Support/Praxis). [cabinet] : Nicolas (par
# défaut), Lorianne, ou un autre dossier de projets/Praxis. L'outil copie cette version de Praxis, y met une copie de la base,
# demande le mot de passe de la base et dit ce que le prochain lancement changerait : champs ajoutés, abandonnés, valeurs
# effacées, ou le refus qui bloquerait l'application. Il n'écrit rien dans le dossier donné ni dans la copie de la base.
set -eu
depot="$(cd "$(dirname "$0")/.." && pwd)"
[ $# -ge 1 ] || { echo "usage : outils/essai-mise-a-jour <dossier de la base> [cabinet]" >&2; exit 2; }
source_base="$(cd "$1" && pwd)"
cabinet="${2:-Nicolas}"
[ -f "$source_base/Praxis.grymd" ] || { echo "Pas de Praxis.grymd dans $source_base." >&2; exit 1; }
[ -x "$depot/grym" ] || (cd "$depot" && make -s grym)
travail="$(mktemp -d)"
trap 'rm -rf "$travail"' EXIT
[ -f "$depot/projets/Praxis/$cabinet/Praxis.grym" ] || { echo "Pas de version « $cabinet » dans projets/Praxis." >&2; exit 1; }
cp -R "$depot/projets/Praxis/$cabinet/." "$travail/"
rm -f "$travail"/*.grymd* "$travail"/*.grymb
cp "$source_base/Praxis.grymd" "$travail/"
[ -f "$source_base/Praxis.grymd.clés" ] && cp "$source_base/Praxis.grymd.clés" "$travail/"
echo "Praxis du dépôt : $(cd "$depot" && git log --oneline -1 | cut -c1-70)"
echo "Base essayée : une copie de $source_base/Praxis.grymd ($(wc -c < "$source_base/Praxis.grymd" | tr -d ' ') octets)"
if [ -z "${GRYM_MOT_DE_PASSE_BASE:-}" ]; then
    printf "Mot de passe de la base (il ne s'affiche pas) : "
    stty -echo 2>/dev/null || true
    read -r mdp
    stty echo 2>/dev/null || true
    echo
    GRYM_MOT_DE_PASSE_BASE="$mdp"
    export GRYM_MOT_DE_PASSE_BASE
fi
echo "--- Ce que le prochain lancement ferait :"
cd "$travail"
if "$depot/grym" migration Praxis.grym; then
    echo "--- Résultat : la mise à jour passe. Rien n'a été écrit."
else
    echo "--- Résultat : le prochain lancement serait REFUSÉ (ci-dessus, pourquoi). N'installe pas cette version : envoie-moi ce message."
    exit 1
fi
