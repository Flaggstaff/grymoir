#!/bin/sh
# Une Praxis prête pour un cabinet, sans base : copie de projets/Praxis dans _cabinets/<nom>/ (ignoré par Git), qu'on ouvre
# dans l'atelier pour lancer ou fabriquer l'application.
#
#   outils/cabinet nicolas     projets/Praxis telle quelle (départ.grym de Nicolas), sans la base d'essai du projet
#   outils/cabinet lorianne    avec outils/cabinets/lorianne : son départ.grym, ses images (qui remplacent celles de même
#                              nom), sa police, et sa phrase « Les écrans ont … » (apparence.grym)
#
# Le code reste celui de projets/Praxis : une correction s'y fait, puis on relance l'outil. Une copie qui a déjà une base
# n'est pas écrasée sans --effacer : sa base serait perdue.
set -e
depot="$(cd "$(dirname "$0")/.." && pwd)"
nom="$1"
[ -n "$nom" ] || { echo "usage : outils/cabinet <nom> [--effacer]   (nicolas, ou un dossier de outils/cabinets/)" >&2; exit 2; }
source="$depot/projets/Praxis"
dessus="$depot/outils/cabinets/$nom"
[ "$nom" = nicolas ] || [ -d "$dessus" ] || { echo "Pas de cabinet « $nom » dans outils/cabinets/." >&2; exit 1; }
cible="$depot/_cabinets/$nom"
if [ -d "$cible" ]; then
    if ls "$cible"/*.grymd >/dev/null 2>&1 && [ "$2" != "--effacer" ]; then
        echo "$cible a une base : relance avec --effacer pour la perdre et repartir à neuf." >&2
        exit 1
    fi
    rm -rf "$cible"
fi
mkdir -p "$cible/images" "$cible/polices"
cp "$source"/*.grym "$source/projet.grymatelier" "$cible/"
cp "$source"/images/* "$cible/images/"
cp "$source"/polices/* "$cible/polices/"
[ -f "$source/clé-de-secours.pub" ] && cp "$source/clé-de-secours.pub" "$cible/"
if [ -d "$dessus" ]; then
    [ -f "$dessus/départ.grym" ] && cp "$dessus/départ.grym" "$cible/"
    [ -d "$dessus/images" ] && cp "$dessus"/images/* "$cible/images/"
    [ -d "$dessus/polices" ] && cp "$dessus"/polices/* "$cible/polices/"
    if [ -f "$dessus/apparence.grym" ]; then
        phrase="$(cat "$dessus/apparence.grym")"
        awk -v p="$phrase" 'index($0, "Les écrans ont ") == 1 { print p; next } { print }' "$source/Praxis.grym" > "$cible/Praxis.grym"
        grep -qF "$phrase" "$cible/Praxis.grym" || { echo "La phrase « Les écrans ont … » n'a pas été remplacée." >&2; exit 1; }
    fi
fi
echo "Prêt : $cible (sans base). Ouvre ce dossier dans l'atelier."
