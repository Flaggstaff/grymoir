#!/bin/sh
# Banc de mesure de GrymoiR (7 novembre 2026) : quatre programmes de outils/banc/, chacun lancé par grym et comparé à
# son équivalent en Python 3. Chaque mesure est la médiane de N exécutions (3 par défaut), en secondes, temps réel,
# compilation comprise pour GrymoiR (grym lancer compile puis exécute) comme pour Python.
#   outils/banc-de-mesure [N]
# Ce banc mesure des ordres de grandeur sur une machine donnée ; il ne vérifie rien et ne bloque aucune publication.
racine=$(cd "$(dirname "$0")/.." && pwd)
grym="$racine/grym"
banc="$racine/outils/banc"
n="${1:-3}"
[ -x "$grym" ] || { echo "banc-de-mesure : construis d'abord grym (make)."; exit 1; }
command -v python3 > /dev/null || { echo "banc-de-mesure : python3 manque."; exit 1; }
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
cp "$banc"/*.grym "$banc"/*.py "$d"/
cd "$d" || exit 1

# la médiane de n mesures d'une commande, en secondes ; la sortie de la dernière va dans sortie.txt
mesurer() {
    i=0
    : > temps.txt
    while [ "$i" -lt "$n" ]; do
        rm -f ./*.grymd ./*.sqlite
        python3 -c 'import subprocess, sys, time
t = time.perf_counter()
r = subprocess.run(sys.argv[1:], stdout=open("sortie.txt", "w"), stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
print("%.3f" % (time.perf_counter() - t) if r.returncode == 0 else "échec")' "$@" >> temps.txt
        i=$((i + 1))
    done
    if grep -q échec temps.txt; then echo "échec"; else sort -n temps.txt | sed -n "$(( (n + 1) / 2 ))p"; fi
}

printf '%-10s %10s %10s %8s   %s\n' "programme" "GrymoiR" "Python" "rapport" "ce qu'il mesure"
for p in boucle appels tri base; do
    case "$p" in
        boucle) quoi="1 000 000 additions et multiplications en décimal exact (Python : module decimal)";;
        appels) quoi="fib(27) récursif : 300 000 appels de calcul environ";;
        tri) quoi="100 000 textes construits puis triés dans l'ordre du dictionnaire";;
        base) quoi="10 000 objets conservés, un compte filtré, 1 000 recherches par champ unique (Python : sqlite3)";;
    esac
    tg=$(mesurer "$grym" lancer "$p.grym")
    sg=$(tail -1 sortie.txt)
    tp=$(mesurer python3 "$p.py")
    sp=$(tail -1 sortie.txt)
    r=$(python3 -c 'import sys
try: print("%.1f×" % (float(sys.argv[1]) / float(sys.argv[2])))
except Exception: print("?")' "$tg" "$tp")
    printf '%-10s %10s %10s %8s   %s\n' "$p" "$tg" "$tp" "$r" "$quoi"
    [ "$sg" = "$sp" ] || [ "$p" = boucle ] || echo "           (résultats différents : GrymoiR « $sg », Python « $sp »)"
done
tf=$(mesurer python3 boucle_flottant.py)
printf '%-10s %10s %10s %8s   %s\n' "flottants" "-" "$tf" "" "la boucle en flottants binaires, que GrymoiR refuse : son résultat est faux au 5e décimal"
echo
echo "Médianes de $n exécutions, en secondes. grym : $(cd "$racine" && git log -1 --format=%h 2>/dev/null || echo '?') ; $(python3 --version 2>&1) ; $(uname -sm)."
