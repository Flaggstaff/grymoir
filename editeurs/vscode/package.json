{
  "name": "grymoir",
  "displayName": "GrymoiR",
  "description": "Langage GrymoiR : coloration, erreurs en direct, autocomplétion et mise en forme, pour la forme littéraire (.grym) et la forme compacte (.grymc).",
  "version": "0.4.0",
  "publisher": "flaggstaff",
  "repository": { "type": "git", "url": "https://github.com/Flaggstaff/grymoir" },
  "engines": { "vscode": "^1.91.0" },
  "categories": ["Programming Languages", "Formatters"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "grymoir",
        "aliases": ["GrymoiR", "grymoir"],
        "extensions": [".grym"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "grymoir-compact",
        "aliases": ["GrymoiR (forme compacte)"],
        "extensions": [".grymc"],
        "configuration": "./language-configuration-compact.json"
      }
    ],
    "grammars": [
      { "language": "grymoir", "scopeName": "source.grymoir", "path": "./syntaxes/grymoir.tmLanguage.json" },
      { "language": "grymoir-compact", "scopeName": "source.grymoir-compact", "path": "./syntaxes/grymoir-compact.tmLanguage.json" }
    ],
    "configuration": {
      "title": "GrymoiR",
      "properties": {
        "grymoir.chemin": {
          "type": "string",
          "default": "grym",
          "markdownDescription": "Chemin de l'outil `grym` (par exemple `/Users/moi/grymoir/grym`). Par défaut, `grym` est cherché dans le `PATH`."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  }
}
